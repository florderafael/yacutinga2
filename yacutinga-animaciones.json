        "gradiente": "se oscurece",
        "flecha": "opacity 0.85 → 1, scale 1.06, fondo claro",
        "descripcion": "max-height 0 → 96px, opacity 0 → 1, translateY(6px) → 0"
      },
      "duracion": "imagen 0.8s · gradiente 0.4s · flecha 0.35s · descripción 0.45s",
      "easing": "ease",
      "repeticion": "por interacción",
      "notas": "En mobile la descripción está siempre visible (sin hover)."
    },
    {
      "id": "alojamiento-card-hover",
      "nombre": "Tarjetas de alojamiento (hover)",
      "componente": "Accommodation.tsx",
      "tipo": "hover",
      "disparador": "mouse sobre la tarjeta",
      "objetivo": ".acc-card y sus hijos",
      "propiedades": {
        "imagen": "scale en hover (transform 0.8s)",
