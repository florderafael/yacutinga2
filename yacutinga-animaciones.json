      "duracion": "0.25s",
      "easing": "ease",
      "repeticion": "por interacción"
    },
    {
      "id": "paquetes-btn-hover",
      "nombre": "Botón 'Consultar disponibilidad' (paquetes)",
      "componente": "Packages.tsx",
      "tipo": "hover",
      "disparador": "mouse sobre el botón",
      "objetivo": "Botón cream del panel",
      "propiedades": { "background": "#F2EDE3 → #E2DAC8", "transform": "translateY(0) → translateY(-2px)" },
      "duracion": "0.25s",
      "easing": "ease",
      "repeticion": "por interacción"
    },
    {
      "id": "comollegar-btn-hover",
      "nombre": "Botón 'Coordinar mi llegada'",
      "componente": "HowToArrive.tsx",
      "tipo": "hover",
      "disparador": "mouse sobre el botón",
      "objetivo": "Botón verde",
      "propiedades": { "background": "#1B2E1C → #3D5A3E", "transform": "translateY(0) → translateY(-2px)" },
      "duracion": "0.25s",
      "easing": "ease",
      "repeticion": "por interacción"
    },
    {
      "id": "testimonios-carrusel",
      "nombre": "Carrusel de testimonios",
      "componente": "Reviews.tsx",
      "tipo": "smooth-scroll",
      "disparador": "click en las flechas ← →",
      "objetivo": ".rev-cards (fila scrolleable)",
