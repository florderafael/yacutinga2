      "duracion": "imagen 0.8s · gradiente 0.4s · panel 0.4s · estado reposo 0.35s",
      "easing": "ease",
      "repeticion": "por interacción",
      "notas": "En reposo se ve imagen + título; en hover aparece el panel de color con detalles. En mobile se muestra apilado."
    },
    {
